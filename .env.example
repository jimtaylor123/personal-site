# CARTO Basemaps key. Request one at https://carto.com/basemaps/apikey
# Copy this file to .env.local for development, or set the variable in
# your host's build environment for production (Netlify: site settings).
#
# Use a local key restricted to localhost / 127.0.0.1 for development,
# and a separate key restricted to your production domain for deploys.
VITE_CARTO_API_KEY=
